{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex-project-context/schemas/plan-document.schema.json",
  "title": "Codex Project Plan Managed Data",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "plans"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "plans": {
      "type": "array",
      "items": { "$ref": "#/$defs/plan" }
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "status": {
      "enum": ["proposed", "accepted", "in-progress", "completed", "rejected", "superseded"]
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "reason", "at"],
      "properties": {
        "from": { "oneOf": [{ "$ref": "#/$defs/status" }, { "type": "null" }] },
        "to": { "$ref": "#/$defs/status" },
        "reason": { "type": "string", "minLength": 1 },
        "at": { "type": "string", "format": "date-time" }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "summary",
        "status",
        "successCriteria",
        "specRefs",
        "decisions",
        "createdAt",
        "updatedAt",
        "transitions"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^P[0-9]+$" },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/status" },
        "successCriteria": { "$ref": "#/$defs/stringArray" },
        "specRefs": { "$ref": "#/$defs/stringArray" },
        "decisions": { "$ref": "#/$defs/stringArray" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "transitions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/transition" }
        }
      }
    }
  }
}
