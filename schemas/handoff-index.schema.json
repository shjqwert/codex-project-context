{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex-project-context/schemas/handoff-index.schema.json",
  "title": "Codex Project Handoff Index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "entries"],
  "properties": {
    "schemaVersion": { "const": 3 },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["specRefs", "bugIds", "modules", "files", "symbols", "tests", "tags"],
      "properties": {
        "specRefs": { "$ref": "#/$defs/stringArray" },
        "bugIds": { "$ref": "#/$defs/stringArray" },
        "modules": { "$ref": "#/$defs/stringArray" },
        "files": { "$ref": "#/$defs/stringArray" },
        "symbols": { "$ref": "#/$defs/stringArray" },
        "tests": { "$ref": "#/$defs/stringArray" },
        "tags": { "$ref": "#/$defs/stringArray" }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "cycle",
        "title",
        "summary",
        "kind",
        "routing",
        "availableSections",
        "groupKey",
        "dedupeKey",
        "path",
        "createdAt"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^W[0-9]+$" },
        "cycle": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["feature", "bug", "investigation", "maintenance", "verification"] },
        "routing": { "$ref": "#/$defs/routing" },
        "availableSections": { "$ref": "#/$defs/stringArray" },
        "groupKey": { "type": "string", "minLength": 1 },
        "dedupeKey": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "path": { "type": "string", "minLength": 1 },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
