{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex-project-context/schemas/context.schema.json",
  "title": "Codex Project Context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectRoot",
    "currentCycle",
    "agentsFile",
    "handoffIndex",
    "capabilities",
    "profile",
    "resources",
    "inventoryFingerprint",
    "analysis"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "projectRoot": { "const": "." },
    "currentCycle": { "type": "string", "minLength": 1 },
    "agentsFile": { "type": "string", "minLength": 1 },
    "handoffIndex": { "type": "string", "minLength": 1 },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codegraph", "serena", "openspec"],
      "properties": {
        "codegraph": { "type": "boolean" },
        "serena": { "type": "boolean" },
        "openspec": { "type": "boolean" }
      }
    },
    "profile": { "$ref": "#/$defs/profile" },
    "inventoryFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "analysis": { "$ref": "#/$defs/analysis" },
    "resources": {
      "type": "array",
      "items": { "$ref": "#/$defs/resource" }
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "projectTypes",
        "languages",
        "sourceDirectories",
        "testDirectories",
        "specificationDirectories"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "projectTypes": { "$ref": "#/$defs/stringArray" },
        "languages": { "$ref": "#/$defs/stringArray" },
        "sourceDirectories": { "$ref": "#/$defs/stringArray" },
        "testDirectories": { "$ref": "#/$defs/stringArray" },
        "specificationDirectories": { "$ref": "#/$defs/stringArray" }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "purpose"],
      "properties": {
        "kind": {
          "enum": ["documentation", "manual", "hardware", "specification", "test"]
        },
        "path": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 }
      }
    },
    "analysisLine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "evidencePaths"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 500 },
        "evidencePaths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "analysisReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "purpose", "evidencePaths"],
      "properties": {
        "kind": { "enum": ["documentation", "manual", "hardware", "specification", "test"] },
        "path": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 500 },
        "evidencePaths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "advisory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "subject", "reason", "action", "evidencePaths"],
      "properties": {
        "kind": { "enum": ["missing-reference", "unconfirmed-fact", "configuration-conflict"] },
        "subject": { "type": "string", "minLength": 1, "maxLength": 200 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
        "action": { "enum": ["remind-user", "none"] },
        "evidencePaths": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "inventoryFingerprint",
        "overview",
        "buildAndVerification",
        "codeAnalysis",
        "references",
        "referenceGuidance",
        "handoffGuidance",
        "advisories"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "inventoryFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "overview": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/analysisLine" } },
        "buildAndVerification": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "$ref": "#/$defs/analysisLine" } },
        "codeAnalysis": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/analysisLine" } },
        "references": { "type": "array", "maxItems": 24, "items": { "$ref": "#/$defs/analysisReference" } },
        "referenceGuidance": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/analysisLine" } },
        "handoffGuidance": {
          "type": "array",
          "maxItems": 3,
          "items": { "$ref": "#/$defs/analysisLine" }
        },
        "advisories": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/advisory" } }
      }
    }
  }
}
