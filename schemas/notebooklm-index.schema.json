{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex/schemas/notebooklm-index.schema.json",
  "title": "NotebookLM Project Index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mode", "notebooks", "components", "notes", "advisories"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "mode": { "enum": ["schematic", "manual", "disabled"] },
    "notebooks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scope", "id", "title"],
        "properties": {
          "scope": { "enum": ["project", "public"] },
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 }
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["refdes", "partNumber", "category", "page", "confidence", "sources"],
        "properties": {
          "refdes": { "type": "string", "minLength": 1 },
          "partNumber": { "type": "string", "minLength": 1 },
          "category": { "enum": ["mcu", "driver", "power", "communication", "sensor", "mos", "other"] },
          "page": { "type": "integer", "minimum": 1 },
          "confidence": { "enum": ["high", "medium", "low"] },
          "package": { "type": "string", "minLength": 1 },
          "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["notebookId", "noteId", "title", "subject", "status"],
        "properties": {
          "notebookId": { "type": "string", "minLength": 1 },
          "noteId": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "subject": { "type": "string", "minLength": 1 },
          "status": { "enum": ["verified", "provisional"] }
        }
      }
    },
    "advisories": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "schematic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 5, "pattern": "\\.[pP][dD][fF]$" },
        "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "lastRefreshedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["notebookId", "sourceId", "title", "documentType", "status"],
      "properties": {
        "notebookId": { "type": "string", "minLength": 1 },
        "sourceId": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "documentType": { "enum": ["datasheet", "reference-manual", "errata", "application-note", "hardware-design-guide", "other"] },
        "status": { "enum": ["ready", "processing", "error", "missing", "unverified"] },
        "version": { "type": "string", "minLength": 1 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "schematic" } }, "required": ["mode"] },
      "then": { "required": ["schematic"], "properties": { "notebooks": { "minItems": 1 } } },
      "else": { "not": { "required": ["schematic"] } }
    },
    {
      "if": { "properties": { "mode": { "enum": ["schematic", "manual"] } }, "required": ["mode"] },
      "then": { "properties": { "notebooks": { "minItems": 1 } } }
    }
  ]
}
