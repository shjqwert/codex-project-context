{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex/schemas/notebooklm-library-manifest.schema.json",
  "title": "NotebookLM PDF Library Upload Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "publicNotebook", "files"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "publicNotebook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size", "modifiedAt", "category", "documentType", "partNumbers", "confidence", "status"],
        "properties": {
          "path": { "type": "string", "minLength": 5, "pattern": "\\.[pP][dD][fF]$" },
          "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "size": { "type": "integer", "minimum": 0 },
          "modifiedAt": { "type": "string", "format": "date-time" },
          "category": { "enum": ["mcu", "driver", "mos", "other-ic"] },
          "documentType": { "enum": ["datasheet", "reference-manual", "errata", "application-note", "hardware-design-guide", "other"] },
          "partNumbers": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "confidence": { "enum": ["high", "medium", "low"] },
          "status": { "enum": ["pending", "ready", "failed", "ambiguous", "duplicate", "superseded"] },
          "manufacturer": { "type": "string", "minLength": 1 },
          "documentNumber": { "type": "string", "minLength": 1 },
          "revision": { "type": "string", "minLength": 1 },
          "publishedAt": { "type": "string", "format": "date-time" },
          "sourceId": { "type": "string", "minLength": 1 },
          "sourceTitle": { "type": "string", "minLength": 1 },
          "lastAttemptAt": { "type": "string", "format": "date-time" }
        },
        "allOf": [
          {
            "if": { "properties": { "status": { "enum": ["ready", "duplicate", "superseded"] } }, "required": ["status"] },
            "then": { "required": ["sourceId", "sourceTitle"] }
          }
        ]
      }
    }
  }
}
